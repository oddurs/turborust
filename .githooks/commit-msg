#!/bin/sh
# Validates a commit message before it becomes an object.
#
# Two jobs: keep the log conventional and readable, and make attribution
# impossible to add by accident. The second matters more — a message is easy to
# rewrite before it is committed and awkward afterwards, and a tool inserting a
# footer by default should fail loudly rather than quietly succeed.

set -eu
msg_file="$1"
# Strip comments and the diff a verbose commit appends, so neither is scanned.
msg=$(sed -e '/^#/d' -e '/^diff --git/,$d' "$msg_file")
subject=$(printf '%s\n' "$msg" | sed -n '1p')

die() {
    printf '\n  commit rejected: %s\n\n' "$1" >&2
    shift
    for line in "$@"; do printf '  %s\n' "$line" >&2; done
    printf '\n' >&2
    exit 1
}

# --- attribution ------------------------------------------------------------
# Deliberately broad. A false positive costs one reworded line; a false negative
# puts a permanent footer in the history of a public repository.
if printf '%s' "$msg" | grep -qiE 'co-authored-by:.*(claude|anthropic|copilot|cursor|codex|gpt|assistant)'; then
    die "the message carries an AI co-author trailer" \
        "This repository never attributes work to a tool." \
        "Remove the Co-Authored-By line."
fi
if printf '%s' "$msg" | grep -qiE 'generated with|made with claude|🤖|as an ai|ai-generated|written by (claude|an ai)'; then
    die "the message contains a generated-by attribution" \
        "This repository never attributes work to a tool." \
        "Remove the footer and describe the change in your own words."
fi

# --- shape ------------------------------------------------------------------
[ -n "$subject" ] || die "the subject line is empty"

case "$subject" in
    fixup!*|squash!*|Revert*|"Merge "*) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -qE '^(feat|fix|chore|docs|perf|refactor|test|build|ci)(\([a-z0-9._-]+\))?!?: .+'; then
    die "the subject is not a Conventional Commit" \
        "Expected:  <type>(<scope>): <imperative summary>" \
        "Types:     feat fix chore docs perf refactor test build ci" \
        "" \
        "Got:       $subject"
fi

if [ "${#subject}" -gt 72 ]; then
    die "the subject is ${#subject} characters; keep it under 72" \
        "Move the detail into the body, which is where it reads better anyway."
fi

case "$subject" in
    *.) die "the subject ends with a period" "Subjects are titles, not sentences." ;;
esac
