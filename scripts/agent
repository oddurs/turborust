#!/usr/bin/env bash
#
# One unit of work, one worktree, one branch, one pull request.
#
# Exists so the workflow is identical whoever is driving — a human, or one of
# several agents working in parallel. Parallelism is the reason for worktrees
# rather than branch switching: two tasks in one checkout will eventually fight
# over the index, the target directory, or a half-applied edit, and the failure
# looks like a bug in the code rather than a bug in the process.
#
#   scripts/agent start 0041        take a tracker item: worktree, branch, claim
#   scripts/agent start feat "add X"  or start freehand
#   scripts/agent check             formatter, linter, tests, roadmap
#   scripts/agent commit "msg"      conventional commit with a Refs trailer
#   scripts/agent pr                push and open a pull request
#   scripts/agent list              active worktrees
#   scripts/agent clean             remove worktrees whose branch is merged
#
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
repo_name=$(basename "$repo_root")
default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || true)
default_branch=${default_branch:-main}
worktree_root=${AGENT_WORKTREES:-"$(dirname "$repo_root")/.worktrees/$repo_name"}

dim()  { printf '\033[2m%s\033[0m\n' "$*"; }
say()  { printf '\033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
die()  { printf '\n\033[31m%s\033[0m\n\n' "$*" >&2; exit 1; }

# `sed -E` deliberately: BSD sed has no `\+` in basic regex, so the portable
# form silently passes the string through unchanged — which produces a branch
# name with spaces in it and a confusing failure from git rather than from here.
slugify() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E -e 's/[^a-z0-9]+/-/g' -e 's/^-+//' -e 's/-+$//' \
        | cut -c1-48 \
        | sed -E 's/-+$//'
}

# Tracker types map onto commit types; anything unknown is a chore.
tracker_type_to_prefix() {
    case "$1" in
        bug)     echo fix ;;
        feature) echo feat ;;
        docs)    echo docs ;;
        *)       echo chore ;;
    esac
}

has_cairn() { command -v cairn >/dev/null 2>&1 && [ -f "$repo_root/cairn.toml" ]; }

cmd_start() {
    [ $# -ge 1 ] || die "usage: agent start <tracker-id> | agent start <type> \"<title>\""

    local prefix slug refs=""
    if [[ "$1" =~ ^[0-9]+$ ]] && has_cairn; then
        local id json title type
        id=$(printf '%04d' "$1")
        json=$(cd "$repo_root" && cairn show "$1" --json 2>/dev/null) \
            || die "no tracker item $id"
        title=$(printf '%s' "$json" | python3 -c 'import sys,json;print(json.load(sys.stdin)["title"])')
        type=$(printf '%s' "$json" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("type","chore"))')
        prefix=$(tracker_type_to_prefix "$type")
        slug="$id-$(slugify "$title")"
        refs="$id"
        say "$id  $title"
    else
        [ $# -ge 2 ] || die "usage: agent start <type> \"<title>\""
        prefix="$1"; shift
        slug=$(slugify "$*")
    fi

    local branch="$prefix/$slug"
    local dir="$worktree_root/$(slugify "$branch")"

    git -C "$repo_root" show-ref --quiet "refs/heads/$branch" \
        && die "branch $branch already exists — 'agent list' to find its worktree"
    [ -e "$dir" ] && die "$dir already exists"

    # Branch from the default branch, not from wherever the primary checkout
    # happens to be sitting.
    mkdir -p "$worktree_root"
    git -C "$repo_root" worktree add -b "$branch" "$dir" "$default_branch" >/dev/null
    [ -n "$refs" ] && printf '%s\n' "$refs" > "$dir/.agent-refs"

    # Claiming is what stops two agents starting the same item.
    if [ -n "$refs" ] && has_cairn; then
        (cd "$dir" && cairn claim "$refs" >/dev/null 2>&1) || warn "could not claim $refs"
    fi

    say "$branch"
    dim "  $dir"
    printf '\n  cd %s\n\n' "$dir"
}

cmd_check() {
    say "checking"
    dim "  formatting"; cargo fmt --check || die "run: cargo fmt"
    dim "  lints";      cargo clippy --all-targets --quiet -- -D warnings
    dim "  tests"
    # Captured rather than piped: a pipeline hides which test failed, and "1
    # failed" without a name is the least useful thing a check can say.
    local out
    if ! out=$(cargo test --quiet 2>&1); then
        printf '%s\n' "$out" | grep -E '^test result:|^test .*FAILED' | sed 's/^/    /'
        printf '%s\n' "$out" | grep -A4 '^---- ' | head -12 | sed 's/^/    /'
        die "tests are failing"
    fi
    printf '%s\n' "$out" | grep -E '^test result:' | sed 's/^/    /'
    if has_cairn; then dim "  roadmap"; cairn check | sed 's/^/    /'; fi
    say "green"
}

cmd_commit() {
    [ $# -ge 1 ] || die 'usage: agent commit "<type>(<scope>): <summary>"'
    local msg="$1"
    local refs=""
    [ -f .agent-refs ] && refs=$(cat .agent-refs)

    git add -A
    # Never stage the script's own bookkeeping, even if the repository has not
    # yet learned to ignore it.
    git reset --quiet -- .agent-refs 2>/dev/null || true
    git diff --cached --quiet && die "nothing staged"

    # The Refs trailer is added here rather than typed each time, so it is never
    # the thing that gets forgotten.
    if [ -n "$refs" ]; then
        git commit -m "$msg" -m "Refs: $refs"
    else
        git commit -m "$msg"
    fi
}

cmd_pr() {
    local branch; branch=$(git rev-parse --abbrev-ref HEAD)
    [ "$branch" = "$default_branch" ] && die "refusing to open a PR from $default_branch"

    git remote get-url origin >/dev/null 2>&1 \
        || die "no remote configured — add one, then rerun"

    cmd_check
    git push -u origin "$branch"

    local title body refs=""
    [ -f .agent-refs ] && refs=$(cat .agent-refs)
    title=$(git log -1 --pretty=%s)

    # The tracker item already states the problem and the acceptance criteria;
    # restating them in the PR by hand is how the two drift apart.
    body=$(git log "$default_branch..HEAD" --reverse --pretty='%s%n%n%b' | sed '/^Refs: /d')
    if [ -n "$refs" ] && has_cairn; then
        body="$body

---

$(cairn show "$refs" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')"
    fi

    gh pr create --title "$title" --body "$body" --base "$default_branch"
}

cmd_list() {
    # Collected first rather than piped: `grep` finding nothing exits 1, and
    # under `pipefail` that would abort the script instead of printing "none".
    local rows
    rows=$(git worktree list | grep -v "^$repo_root " || true)
    if [ -z "$rows" ]; then
        dim "  no active worktrees"
        return 0
    fi
    printf '%s\n' "$rows" | while read -r dir _ branch; do
        printf '  \033[1m%s\033[0m\n    %s\n' "${branch//[\[\]]/}" "$dir"
    done
}

# True when a branch's work has landed on the default branch.
#
# Two cases, because a merge commit and a squash merge look nothing alike: after
# a squash the branch's commits are ancestors of nothing, so the ancestor test
# alone quietly leaves every squash-merged worktree behind — and squash is the
# default merge strategy, so that would be most of them.
branch_has_landed() {
    local branch="$1"
    git merge-base --is-ancestor "$branch" "$default_branch" 2>/dev/null && return 0
    # A vanished upstream means the remote branch was deleted, which is what a
    # merge with --delete-branch does.
    if ! git rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
        git config --get "branch.$branch.remote" >/dev/null 2>&1 && return 0
    fi
    # Otherwise ask the forge. From git alone, a squash-merged branch whose
    # remote still exists is indistinguishable from an unmerged one.
    command -v gh >/dev/null 2>&1 || return 1
    [ "$(gh pr view "$branch" --json state -q .state 2>/dev/null)" = "MERGED" ]
}

cmd_clean() {
    git fetch --prune --quiet origin 2>/dev/null || true
    local removed=0
    while read -r dir _ branch; do
        branch=${branch//[\[\]]/}
        [ "$dir" = "$repo_root" ] && continue
        if branch_has_landed "$branch"; then
            dim "  removing $branch"
            # Worktree first: git refuses to delete a branch a worktree holds,
            # which is also why `gh pr merge --delete-branch` cannot tidy up on
            # its own. This command owns the whole teardown instead.
            git worktree remove "$dir" --force
            git branch -D "$branch" >/dev/null 2>&1 || true
            git push --quiet origin --delete "$branch" >/dev/null 2>&1 || true
            removed=$((removed + 1))
        fi
    done < <(git worktree list)
    git worktree prune
    if [ "$removed" -eq 0 ]; then
        dim "  nothing merged to clean up"
    else
        say "removed $removed"
    fi
}

case "${1:-}" in
    start)  shift; cmd_start "$@" ;;
    check)  shift; cmd_check ;;
    commit) shift; cmd_commit "$@" ;;
    pr)     shift; cmd_pr ;;
    list)   shift; cmd_list ;;
    clean)  shift; cmd_clean ;;
    # Help is the header comment, so the two can never disagree.
    *)      awk 'NR>2 && /^#/ { sub(/^# ?/, ""); print; next } NR>2 { exit }' "$0" ;;
esac
