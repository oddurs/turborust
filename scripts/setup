#!/usr/bin/env bash
#
# Everything a fresh clone needs, in one idempotent command.
#
# This exists because the most important parts of the workflow — the hooks and
# the commit template — live in *local git config*, not in tracked content. A
# clone gets the files and none of the enforcement, which is precisely the
# failure the hooks were written to prevent.
#
#   scripts/setup          install and report
#   scripts/setup --check  report only; exits non-zero if something is missing
#
set -euo pipefail

check_only=false
[ "${1:-}" = "--check" ] && check_only=true

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
todo() { printf '  \033[33m·\033[0m %s\n' "$*"; }
info() { printf '  \033[2m%s\033[0m\n' "$*"; }
missing=0

want_config() {
    local key="$1" value="$2" label="$3"
    if [ "$(git config --get "$key" || true)" = "$value" ]; then
        ok "$label"
        return
    fi
    if $check_only; then
        todo "$label — run scripts/setup"
        missing=$((missing + 1))
        return
    fi
    git config "$key" "$value"
    ok "$label"
}

printf '\n\033[1mturborust\033[0m — development setup\n\n'

# The two that matter: without them the hooks are inert and the template unused.
want_config core.hooksPath .githooks "git hooks (formatting, conventions, tests)"
want_config commit.template .gitmessage "commit message template"

# Hooks are only useful if they can run.
if [ -x .githooks/commit-msg ]; then
    ok "hooks are executable"
else
    if $check_only; then
        todo "hooks are not executable"
        missing=$((missing + 1))
    else
        chmod +x .githooks/* scripts/* 2>/dev/null || true
        ok "hooks made executable"
    fi
fi

printf '\n'
if command -v cargo >/dev/null 2>&1; then
    ok "cargo $(cargo --version | cut -d' ' -f2)"
else
    todo "cargo not found — install from https://rustup.rs"
    missing=$((missing + 1))
fi

for tool in gh just cairn; do
    if command -v "$tool" >/dev/null 2>&1; then
        ok "$tool"
    else
        # None of these are required to build or test; say so rather than
        # implying a broken setup.
        info "$tool not found (optional: $(case $tool in
            gh) echo 'scripts/agent pr' ;;
            just) echo 'just <task> shortcuts' ;;
            cairn) echo 'roadmap commands' ;;
        esac))"
    fi
done

if $check_only; then
    printf '\n'
    [ "$missing" -eq 0 ] && exit 0
    printf '  \033[33m%d thing(s) need setting up: run scripts/setup\033[0m\n\n' "$missing"
    exit 1
fi

printf '\n  \033[2mNot installed for you, deliberately:\033[0m\n'
printf '  \033[2m  a faster linker is machine-specific — committing one would break\n'
printf '    anyone without it. Run `turborust doctor --fix` to set it up locally.\033[0m\n'
printf '\n  Next:  \033[1mcargo test\033[0m   then   \033[1mscripts/agent start <id>\033[0m\n\n'
